                  "pm.test('field is role', () => pm.expect(pm.response.json().field).to.eql('role'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sneaky Person\",\n  \"email\": \"sneaky-{{$timestamp}}@example.com\",\n  \"password\": \"first-pass-1\",\n  \"role\": \"admin\"\n}",
              "options": {
