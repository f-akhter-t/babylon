        {
          "name": "8 weeks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('cards equal the sum of the rows', () => { const d = body.data; pm.expect(d.departments).to.have.length(4); pm.expect(d.stats.received).to.eql(d.departments.reduce((n, r) => n + r.assigned, 0)); pm.expect(d.stats.resolved).to.eql(d.departments.reduce((n, r) => n + r.resolved, 0)); });",
                  "pm.test('weekly has 8 entries that add up', () => { const d = body.data; pm.expect(d.weekly).to.have.length(8); pm.expect(d.weekly.reduce((n, w) => n + w.received, 0)).to.eql(d.stats.received); });",
                  "pm.test('waiting longest is longest first', () => { const days = body.data.waitingLongest.map(w => w.days); pm.expect(days).to.eql([...days].sort((a, b) => b - a)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
