# Copy this file to .env and fill it in. Never commit .env.
PORT=5000

# MongoDB connection string. Give each person their own database name at the end.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/babylon_yourname?retryWrites=true&w=majority

# Signs sign-in tokens. At least 16 characters. Use a long random value on Vercel.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. How long a token lasts (default 7d).
# JWT_EXPIRES_IN=7d

# The frontend address allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# CLIP photo severity (F1). true = assess report photos (downloads about 150 MB on first use).
# On by default. Only a host that cannot hold the model should set it to false; reports are still created.
CLIP_ENABLED=true

# Set to production on the live site. The seed and token scripts then refuse to run.
# NODE_ENV=production

# Gemini (translate, report assistant, summaries). Each person uses their own key.
# The key stays on the server and never goes in the frontend.
GEMINI_API_KEY=your-own-gemini-key
GEMINI_MODEL=gemini-3.5-flash

# Phone codes: 'dev' accepts the fixed demo code. Anything else disables codes.
PHONE_CODE_MODE=dev

# Email codes (forgot password).
#   dev   the code is always 123456 and nothing is emailed. For local work and Postman.
#   smtp  a random code is emailed through Gmail (needs the two lines below).
# Anything else turns email codes off. 'dev' is refused when NODE_ENV=production,
# because a fixed code would let anyone reset any password.
EMAIL_MODE=dev
# Only for EMAIL_MODE=smtp: a Gmail address and its app password (not the normal
# password). Create one under Google Account, Security, 2-Step Verification, App passwords.
# EMAIL_USER=your-address@gmail.com
# EMAIL_APP_PASSWORD=abcd efgh ijkl mnop


# Staff accounts. These three stay on the server (and in the Vercel backend project);
# they are never in the frontend. Write each on ONE line. Use your own values.
#   STAFF_ACCESS_CODE  the one code a new staff member types on /staff/signup.
#   DEPARTMENT_CODES   the code that proves a department officer's department.
#   EMPLOYEE_ROSTER    the Employee IDs each department (and "admin") may claim.
# An empty or missing value means nobody passes that check.
STAFF_ACCESS_CODE=change-me-staff-access-code
DEPARTMENT_CODES={"Roads & Highways":"change-me","Waste Management":"change-me","Water Supply":"change-me","Electricity":"change-me"}
EMPLOYEE_ROSTER={"Roads & Highways":["E-RH-0001"],"Waste Management":["E-WM-0001"],"Water Supply":["E-WS-0001"],"Electricity":["E-EL-0001"],"admin":["E-AD-0001"]}


