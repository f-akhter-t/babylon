{
  "info": {
    "name": "Babylon: Department and Citizen Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "deptToken",
      "value": ""
    },
    {
      "key": "citizenToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 No token gives 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/department/issues",
        "description": "Expected: 401, code unauthorized. No Authorization header is sent on purpose."
      }
    },
    {
      "name": "2 Citizen token on department route gives 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{citizenToken}}"
          }
        ],
        "url": "{{baseUrl}}/department/issues",
        "description": "Expected: 403, code forbidden. Put a citizen token in the Authorization header."
      }
    },
    {
      "name": "3 Assigned list: 3 issues, ranked, no Waste",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          }
        ],
        "url": "{{baseUrl}}/department/issues?scope=assigned",
        "description": "Expected: 200. data holds 3 issues, ranked 1, 2, 3, and the first title is \"Cracked footbridge rail\". No Waste issue and no reopened issue. Send on a freshly seeded database."
      }
    },
    {
      "name": "4 Completed list: 1 resolved issue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          }
        ],
        "url": "{{baseUrl}}/department/issues?scope=completed",
        "description": "Expected: 200. data holds 1 issue and its status is resolved."
      }
    },
    {
      "name": "5 Bad scope gives 400",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          }
        ],
        "url": "{{baseUrl}}/department/issues?scope=nonsense",
        "description": "Expected: 400, code invalid, field scope."
      }
    },
    {
      "name": "6 Summary equals the list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          }
        ],
        "url": "{{baseUrl}}/department/summary",
        "description": "Expected: 200. data is assigned 3, open 2, inProgress 1, awaiting 0, completed 1 on a fresh seed. open + inProgress + awaiting equals assigned. Send before requests 7 and 11, because they change the counts."
      }
    },
    {
      "name": "7 Start work: first call 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000001/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"in-progress\"}"
        },
        "description": "Expected: 200. data.status is in-progress and data.startedAt is a date string. The reporter gets an in-progress alert. This changes the database, so re-seed before sending it again."
      }
    },
    {
      "name": "8 Start work: second call 409",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000001/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"in-progress\"}"
        },
        "description": "Expected: 409, code conflict. Send right after request 7."
      }
    },
    {
      "name": "9 Start work on a Waste issue gives 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000004/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"in-progress\"}"
        },
        "description": "Expected: 403, code forbidden. This issue belongs to the Waste department and stays open."
      }
    },
    {
      "name": "10 Submit without a photo gives 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000002/submit",
        "body": {
          "mode": "raw",
          "raw": "{\"note\":\"Patched\"}"
        },
        "description": "Expected: 400, code invalid, field photoUrl. The body has a note but no photo."
      }
    },
    {
      "name": "11 Submit with a photo gives 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000002/submit",
        "body": {
          "mode": "raw",
          "raw": "{\"note\":\"Patched\",\"photoUrl\":\"data:image/png;base64,iVBORw0KGgo=\"}"
        },
        "description": "Expected: 200. data.verification is awaiting and data.departmentNote is Patched. The reporter and the admins get an alert. This changes the database, so re-seed before sending it again."
      }
    },
    {
      "name": "12 Submit again gives 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/department/issues/a1b2c3000000000000000002/submit",
        "body": {
          "mode": "raw",
          "raw": "{\"note\":\"Patched\",\"photoUrl\":\"data:image/png;base64,iVBORw0KGgo=\"}"
        },
        "description": "Expected: 409, code conflict. Send right after request 11."
      }
    },
    {
      "name": "13 Citizen profile gives 200, no NID photo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{citizenToken}}"
          }
        ],
        "url": "{{baseUrl}}/citizen/profile",
        "description": "Expected: 200. data.division is Dhaka, the text has no photo and no passwordHash, and identity.status is \"not-submitted\" when the citizen has no identity record. The body also has role, department, phoneVerified, isVerified and the staff fields."
      }
    },
    {
      "name": "14 Profile with a department token gives 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deptToken}}"
          }
        ],
        "url": "{{baseUrl}}/citizen/profile",
        "description": "Expected: 403, code forbidden. A department token is not allowed on a citizen route."
      }
    }
  ]
}
