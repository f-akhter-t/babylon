{
  "info": {
    "name": "Babylon: Admin panel",
    "description": "Meheri's 11 admin endpoints. Before running: npm run seed:admin, then paste three tokens into the collection variables (npm run token -- admin, npm run token -- department, npm run token -- citizen). Run the folders in order with the Collection Runner. Re-run npm run seed:admin before every full run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "departmentToken",
      "value": ""
    },
    {
      "key": "citizenToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup: read the seeded data (run first, on a fresh npm run seed:admin)",
      "item": [
        {
          "name": "Counts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('3 waiting, 1 reopened', () => { pm.expect(body.data.queue).to.eql(3); pm.expect(body.data.reopened).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/counts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "counts"
              ]
            }
          }
        },
        {
          "name": "Queue (save ids)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('3 fixes, newest first', () => { pm.expect(body.data).to.have.length(3); const t = body.data.map(i => new Date(i.submittedAt).getTime()); pm.expect(t).to.eql([...t].sort((a, b) => b - a)); });",
                  "pm.collectionVariables.set('fixA', body.data[0].id); pm.collectionVariables.set('fixB', body.data[1].id); pm.collectionVariables.set('fixC', body.data[2].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/verification-queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "verification-queue"
              ]
            }
          }
        },
        {
          "name": "Reopened (save id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('1 reopened', () => pm.expect(body.data).to.have.length(1)); pm.collectionVariables.set('reopenedId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/reopened",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "reopened"
              ]
            }
          }
        },
        {
          "name": "Identity queue (save ids)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('4 waiting, oldest first, last 4 digits only', () => { pm.expect(body.data).to.have.length(4); pm.expect(body.data.map(i => i.nidLast4)).to.eql(['4821', '9034', '7390', '1156']); pm.expect(JSON.stringify(body)).to.not.include('photo'); });",
                  "pm.collectionVariables.set('idPhoto', body.data[0].id); pm.collectionVariables.set('idNoPhoto', body.data[1].id); pm.collectionVariables.set('idOk', body.data[2].id);"
                ]
              }
