                  "pm.test('same account', () => pm.expect(pm.response.json().data.user.email).to.eql(pm.collectionVariables.get('newEmail')));",
                  "pm.test('no hash in the answer', () => pm.expect(pm.response.text()).to.not.include('passwordHash').and.not.include('$2b$'));"
                ]
