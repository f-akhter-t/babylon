{
  "name": "babylon-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/seed.admin.js",
    "seed:public": "node scripts/seed.public.js",
    "seed:citizen": "node scripts/seed.citizen.js",
    "clean:seed": "node scripts/clean-seed.js",
    "token": "node scripts/make-token.js",
    "test": "node --experimental-test-module-mocks --test \"tests/*.test.js\"",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true
  }
}
