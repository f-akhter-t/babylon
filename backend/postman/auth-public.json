{
  "info": {
    "name": "Babylon: Auth and Public",
    "description": "Run the folders top to bottom, Auth first. Needs the demo accounts and issues from `npm run seed:public`. Set baseUrl if the server is not on port 5000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "citizenToken",
      "value": ""
    },
    {
      "key": "deptToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "newToken",
      "value": ""
    },
    {
      "key": "newEmail",
      "value": ""
    },
    {
      "key": "issueId",
      "value": ""
    },
    {
      "key": "badLogin",
      "value": ""
    },
    {
      "key": "brokenToken",
      "value": "not-a-real-token"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1 Sign up a new citizen: 201 and a token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newEmail', 'postman-' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('a citizen with a token', () => { pm.expect(d.token).to.be.a('string'); pm.expect(d.user.role).to.eql('citizen'); pm.expect(d.user.email).to.eql(pm.collectionVariables.get('newEmail')); });",
                  "pm.test('no hash in the answer', () => pm.expect(pm.response.text()).to.not.include('passwordHash').and.not.include('$2b$'));",
                  "pm.collectionVariables.set('newToken', d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"first-pass-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2 Same email again: 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('code is conflict', () => pm.expect(pm.response.json().code).to.eql('conflict'));",
                  "pm.test('field is email', () => pm.expect(pm.response.json().field).to.eql('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"first-pass-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3 Sign up asking to be admin: 400",
